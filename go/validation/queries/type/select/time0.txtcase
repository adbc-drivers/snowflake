// part: metadata

[setup]
drop = "test_time0"

// part: setup_query

CREATE TABLE "test_time0" (
    "idx" INTEGER,
    "res" TIME(0)
);

INSERT INTO "test_time0" ("idx", "res") VALUES (1, TIME '13:45:30');
INSERT INTO "test_time0" ("idx", "res") VALUES (2, TIME '00:00:00');
INSERT INTO "test_time0" ("idx", "res") VALUES (3, TIME '23:59:59');
INSERT INTO "test_time0" ("idx", "res") VALUES (4, NULL);

// part: query

SELECT "res" FROM "test_time0" ORDER BY "idx"

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tts",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 49530}
{"res": 0}
{"res": 86399}
{"res": null}
