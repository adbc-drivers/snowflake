// part: metadata

[setup]
drop = "test_timestamp8"

// part: setup_query

CREATE TABLE "test_timestamp8" (
    "idx" INTEGER,
    "res" TIMESTAMP(8)
);

INSERT INTO "test_timestamp8" ("idx", "res") VALUES (1, TIMESTAMP '2023-05-15 13:45:30.12345678');
INSERT INTO "test_timestamp8" ("idx", "res") VALUES (2, TIMESTAMP '2000-01-01 00:00:00.23456789');
INSERT INTO "test_timestamp8" ("idx", "res") VALUES (3, TIMESTAMP '1969-07-20 20:17:40.34567890');
INSERT INTO "test_timestamp8" ("idx", "res") VALUES (4, TIMESTAMP '1677-09-21 00:12:43.15');
INSERT INTO "test_timestamp8" ("idx", "res") VALUES (5, TIMESTAMP '2262-04-11 23:47:16.85');
INSERT INTO "test_timestamp8" ("idx", "res") VALUES (6, NULL);

// part: query

SELECT "res" FROM "test_timestamp8" ORDER BY "idx"
